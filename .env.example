# Copy to .env and fill in. Never commit .env.

# --- Auth: comma-separated API keys clients send in the X-API-Key header ---
API_KEYS=change-me-to-a-long-random-string

# --- E2B (https://e2b.dev/dashboard) ---
E2B_API_KEY=
# Optional custom template id; default is E2B's "base" template
SANDBOX_TEMPLATE=
# Outbound internet from sandboxes (off by default)
SANDBOX_ALLOW_INTERNET=false
SANDBOX_CREATE_RETRIES=3
MAX_CONCURRENT_SANDBOXES=5

# --- Execution policy ---
DEFAULT_TIMEOUT_SECONDS=30
MAX_TIMEOUT_SECONDS=120
MAX_CODE_BYTES=100000
# Per stream (stdout and stderr each)
MAX_OUTPUT_BYTES=65536

# --- API ---
RATE_LIMIT_PER_MINUTE=30
DATABASE_PATH=data/executions.db
LOG_LEVEL=INFO

# --- LLM agent (OpenRouter, OpenAI-compatible) ---
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Cheap for development; use anthropic/claude-sonnet-5.5 for demos.
LLM_MODEL=anthropic/claude-haiku-5.5
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=4
AGENT_TIMEOUT_SECONDS=180
AGENT_MAX_TOKENS=1024

# --- Public demo + console (/demo/*, UI at /) ---
# The browser never holds a key; these caps bound what strangers can spend.
DEMO_ENABLED=false
DEMO_RUNS_PER_HOUR=10
DEMO_AGENT_RUNS_PER_HOUR=3
DEMO_DAILY_RUNS=300
DEMO_DAILY_AGENT_RUNS=40
DEMO_MAX_TIMEOUT_SECONDS=15
DEMO_MAX_CODE_BYTES=10000
DEMO_AGENT_MAX_STEPS=4
DEMO_AGENT_MAX_TOOL_CALLS=2
# Cloudflare Turnstile (bot check). Leave empty to disable.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Only behind a trusted proxy (Fly/Render/etc.): use X-Forwarded-For for visitor limits
TRUST_PROXY=false
# Proxies in front of the app that append to X-Forwarded-For (Render: 1)
TRUSTED_PROXY_HOPS=1
PUBLIC_REPO_URL=
