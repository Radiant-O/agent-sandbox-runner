# Copy to .env and fill in. Never commit .env.

# --- Auth: comma-separated API keys clients send in the X-API-Key header ---
API_KEYS=change-me-to-a-long-random-string

# --- E2B (https://e2b.dev/dashboard) ---
E2B_API_KEY=
# Optional custom template id; default is E2B's "base" template
SANDBOX_TEMPLATE=
# Outbound internet from sandboxes (off by default)
SANDBOX_ALLOW_INTERNET=false
SANDBOX_CREATE_RETRIES=3
MAX_CONCURRENT_SANDBOXES=5

# --- Execution policy ---
DEFAULT_TIMEOUT_SECONDS=30
MAX_TIMEOUT_SECONDS=120
MAX_CODE_BYTES=100000
# Per stream (stdout and stderr each)
MAX_OUTPUT_BYTES=65536

# --- API ---
RATE_LIMIT_PER_MINUTE=30
DATABASE_PATH=data/executions.db
LOG_LEVEL=INFO

# --- LLM agent (OpenRouter, OpenAI-compatible) ---
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=4
AGENT_TIMEOUT_SECONDS=180
AGENT_MAX_TOKENS=1024
